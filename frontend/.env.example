# ==============================================================================
# SIMON Frontend — plantilla de variables de entorno
# ==============================================================================
# Copiar a .env.local y reemplazar solo con valores del entorno correspondiente.
# No subir .env.local ni valores reales al repositorio.
# ==============================================================================

# Origen de datos: 'mock' (datos locales) o 'api' (backend NestJS/Supabase)
NEXT_PUBLIC_DATA_SOURCE=mock

# URL base del backend cuando NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_BASE_URL=https://api.example.invalid/api

# Código de la pantalla por defecto
NEXT_PUBLIC_DEFAULT_SCREEN_CODE=TV-EJEMPLO-01

# Segundos por vista cuando la API no entrega configuración
NEXT_PUBLIC_SLIDE_DURATION_SECONDS=10

# Minutos de pausa antes de reanudar la rotación automáticamente
NEXT_PUBLIC_AUTO_RESUME_MINUTES=10

# URL de realtime cuando el backend expone WebSocket/SSE
NEXT_PUBLIC_REALTIME_URL=wss://realtime.example.invalid
