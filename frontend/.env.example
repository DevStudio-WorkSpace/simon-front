# ==============================================================================
# SIMON Frontend — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local
# ==============================================================================

# Data Source Strategy: 'mock' (simulated local data) or 'api' (NestJS/Supabase backend)
NEXT_PUBLIC_DATA_SOURCE=mock

# Base URL for Backend API (used when NEXT_PUBLIC_DATA_SOURCE=api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Default screen code to broadcast/listen (e.g. TV-SALA-01)
NEXT_PUBLIC_DEFAULT_SCREEN_CODE=TV-SALA-01

# Default slide rotation interval in seconds
NEXT_PUBLIC_SLIDE_DURATION_SECONDS=10

# Inactivity pause timeout in minutes before auto-resuming rotation
NEXT_PUBLIC_AUTO_RESUME_MINUTES=10

# WebSocket / Realtime connection URL (future Sprint integration)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001/realtime

